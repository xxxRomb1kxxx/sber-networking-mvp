# Сервер
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=demo-secret-change-me
SESSION_TTL_SEC=43200

# Хранилище демо-базы (в боевой версии — строка подключения к PostgreSQL)
DB_FILE=./server/data/db.json

# Параметры имитации внешних систем
MOCK_GIGACHAT_LATENCY_MS=900     # искусственная задержка ответа «GigaChat»
MOCK_GIGACHAT_FAILURE_RATE=0     # 0..1 — доля сбоев, включающих фолбэк-подбор
MOCK_AUTO_LIKE_BACK_RATE=0.45    # вероятность ответного лайка демо-профиля
MOCK_AUTO_REPLY_DELAY_MS=4000    # задержка приветствия демо-профиля в чате, 0 — выключить
